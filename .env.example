# Copie este arquivo para .env e preencha os valores locais.
# Nunca envie o arquivo .env para o GitHub.
DATABASE_URL=sqlite:///./todo_list.db
JWT_SECRET=troque-por-uma-chave-secreta-com-pelo-menos-32-caracteres
JWT_EXPIRA_MINUTOS=120

# Para PostgreSQL no Render, substitua DATABASE_URL por uma URL neste formato:
# DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST/BANCO?sslmode=require
